# Copia este archivo como .env y completa tus propios valores.
# El .env real NUNCA se sube a git (ya esta en .gitignore).

# development = HTTPS local con certificado autofirmado (npm run certs)
# production  = HTTP interno; el HTTPS real lo maneja el proxy/hosting
NODE_ENV=development

PORT=3001

# Solo se usan si NODE_ENV=development. Por defecto apuntan a ./certs,
# que es donde "npm run certs" los genera.
SSL_KEY_PATH=./certs/cert.key
SSL_CERT_PATH=./certs/cert.crt

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=petcard

JWT_SECRET=cambia_esto_por_un_valor_largo_y_aleatorio

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

GOOGLE_CREDENTIALS_PATH=./google-credentials.json
GOOGLE_CALENDAR_ID=
